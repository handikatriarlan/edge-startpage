{
	"manifest_version": 3,
	"name": "Edge Startpage",
	"version": "1.0",
	"description": "A custom startpage for my Edge browser.",
	"chrome_url_overrides": {
		"newtab": "index.html"
	},
	"permissions": [
		"storage"
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	},
	"web_accessible_resources": [
		{
			"matches": [
				"<all_urls>"
			]
		}
	]
}